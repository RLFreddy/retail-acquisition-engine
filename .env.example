# ============================================================
# retail-acquisition-engine — configuration
# Copy to .env (optional): every value below is the default.
# ============================================================

# Input CSV and output folder (results, logs/, state/scraper.db), relative to
# the project folder. Used both by `pnpm dev` and by `docker compose run`.
INPUT_CSV=searchresults.csv
OUTPUT_DIR=data

# Products to scrape: 0 = all. Handy for a quick test: LIMIT=10
LIMIT=0

# Politeness: parallel requests, and at most one product starts every DELAY_MS.
CONCURRENCY=4
DELAY_MS=500

# Retries per request on 406/429/5xx/network errors; the wait doubles each
# time (5s, 10s, 20s, 40s).
RETRIES=4
RETRY_DELAY_MS=5000
TIMEOUT_MS=20000

# Resume: a product that failed in MAX_ATTEMPTS runs is abandoned.
# Delete OUTPUT_DIR/state/ (or run `make reset`) to start from scratch.
MAX_ATTEMPTS=5

# Quality check: the run exits with code 1 when nothing was extracted or
# the failure rate is above this (0.1 = 10%).
MAX_FAILURE_RATE=0.1

# Browser-like User-Agent sent with every request.
# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36

# Console colors follow the standard conventions: NO_COLOR=1 / FORCE_COLOR=1
