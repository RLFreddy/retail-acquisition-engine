# ============================================================
# retail-acquisition-engine — configuration
# Copy to .env and run: pnpm dev
# ============================================================

# ------------------------------------------------------------
# Run scope
# ------------------------------------------------------------

# How many pages to process in this run.
#   0  → all pages (total detected by the session opener)
#   N  → only N pages, continuing from where the last run left off
PAGES=4

# ------------------------------------------------------------
# Retries & timing (anti rate-limit)
# ------------------------------------------------------------

# Retries per request on 429/5xx/network failures.
# Exponential backoff: RETRY_BASE_DELAY_MS × 2^(attempt-1)
RETRIES=4
RETRY_BASE_DELAY_MS=1000

# Pause between pages.
REQUEST_DELAY_MS=2500

# Cooldown before opening a new session.
RATE_LIMIT_COOLDOWN_MS=10000

# Max times a session open is attempted before giving up.
MAX_COOLDOWN_CYCLES=3

# Attempts per page before abandoning it (it's skipped and the next continues).
MAX_ATTEMPTS=5

# Consecutive page failures that trigger a session renewal.
FAILURES_BEFORE_RENEW=2

# Proactive rotation: renew the session every N pages (0 = never).
PAGES_PER_SESSION=0

# ------------------------------------------------------------
# Storage
# ------------------------------------------------------------

# Base for ALL storage (SQLite state, output files, errors).
# Docker overrides it with /app/data (persisted in ./data_docker).
BASE_DIR=data

# ------------------------------------------------------------
# Identity
# ------------------------------------------------------------

USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36

# ------------------------------------------------------------
# Debug
# ------------------------------------------------------------

# Print every HTTP payload to the console. Uncomment to debug:
# VERBOSE=1
