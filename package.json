{
  "name": "retail-acquisition-engine",
  "version": "1.0.0",
  "description": "HTTP-only product, variant and customization scraper for 2ndswing.com (Magento 2).",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.14.0",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "csv-parser": "^3.2.1",
    "dotenv": "^18.0.6",
    "p-queue": "^9.3.3",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
